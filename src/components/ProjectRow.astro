---
// One project entry in a list. Port of renderProjectRow() from the old render.js.
// A project with a `caseStudy` gets a badge, a linked title, and a case-study link.
interface Props {
  project: any;
}

const { project: p } = Astro.props;
const href = p.caseStudy ? `/projects/${p.slug}` : "/work";

// Same link set (and "·" separators) as the old renderProjectRow.
const links = [
  p.caseStudy && { href, label: "Case study \u2192", external: false },
  p.liveUrl && { href: p.liveUrl, label: "Live \u2197", external: true },
  p.repoUrl && { href: p.repoUrl, label: "GitHub \u2197", external: true },
].filter(Boolean) as { href: string; label: string; external: boolean }[];
---

<div class="row" style="cursor:default;">
  <div>
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
      <h3 style="font-family:var(--font-display); font-size:21px; font-weight:600; margin:0; letter-spacing:-0.01em;">
        {p.caseStudy ? <a href={href} style="color:inherit;">{p.title}</a> : p.title}
      </h3>
      {p.caseStudy && <span class="chip-accent">case study</span>}
    </div>
    <p style="margin:0 0 12px; font-size:15px; line-height:1.55; color:var(--color-text-soft); max-width:560px;">
      {p.blurb}
    </p>
    <div style={`display:flex; gap:8px; flex-wrap:wrap; margin-bottom:${links.length ? "12px" : "0"};`}>
      {p.tags.map((t: string) => <span class="chip">{t}</span>)}
    </div>
    {
      links.length > 0 && (
        <div style="display:flex; gap:10px; align-items:center;">
          {links.map((l, i) => (
            <>
              {i > 0 && <span style="color:var(--color-border);">&middot;</span>}
              <a
                href={l.href}
                target={l.external ? "_blank" : undefined}
                rel={l.external ? "noopener" : undefined}
                class="link"
                style="font-size:12.5px;"
              >
                {l.label}
              </a>
            </>
          ))}
        </div>
      )
    }
  </div>
  <div style="font-family:var(--font-mono); font-size:12px; color:var(--color-text-softest); white-space:nowrap; padding-top:4px;">
    {p.year}
  </div>
</div>
