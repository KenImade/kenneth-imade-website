---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import ProjectRow from "../components/ProjectRow.astro";
import PostRow from "../components/PostRow.astro";
import { profile } from "../data/profile.js";
import { projects } from "../data/projects.js";
import { getCollection } from "astro:content";

const p = profile;
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Kenneth Imade">
  <Nav rise />

  <header style="max-width:var(--page-width); margin:0 auto; padding:90px 24px 70px;">
    <div
      class="rise"
      style="display:flex; align-items:center; gap:10px; font-family:var(--font-mono); font-size:12.5px; color:var(--color-status-text); margin-bottom:22px;"
    >
      <span
        style="width:7px; height:7px; border-radius:50%; background:var(--color-status-dot); animation: blink 2s ease infinite;"
      ></span>
      <span>{p.statusLine}</span>
    </div>
    <h1
      class="rise"
      style="font-family:var(--font-display); font-weight:600; font-size:56px; line-height:1.08; letter-spacing:-0.02em; margin:0 0 24px; max-width:780px;"
      set:html={p.heroHeadline.join("<br>")}
    />
    <p
      class="rise"
      style="font-size:18px; line-height:1.6; color:var(--color-text-soft); max-width:560px; margin:0 0 34px;"
    >
      {p.heroSub}
    </p>
    <div class="rise" style="display:flex; gap:14px; flex-wrap:wrap;">
      <a href="#work" class="btn btn-dark">See the work &rarr;</a>
      <a href={`mailto:${p.socials.email}`} class="btn btn-ghost">Say hi</a>
    </div>
    <div class="rise" style="display:flex; gap:20px; margin-top:34px;">
      <a
        href={p.socials.github}
        target="_blank"
        rel="noopener"
        style="font-family:var(--font-mono); font-size:13px; color:var(--color-text-softer);">GitHub</a
      >
      <a
        href={p.socials.linkedin}
        target="_blank"
        rel="noopener"
        style="font-family:var(--font-mono); font-size:13px; color:var(--color-text-softer);">LinkedIn</a
      >
      <a
        href={`mailto:${p.socials.email}`}
        style="font-family:var(--font-mono); font-size:13px; color:var(--color-text-softer);">Email</a
      >
    </div>
  </header>

  <section id="work" style="max-width:var(--page-width); margin:0 auto; padding:40px 24px 90px; scroll-margin-top:24px;">
    <div class="section-head">
      <h2 style="font-family:var(--font-display); font-size:26px; font-weight:600; margin:0; letter-spacing:-0.01em;">
        Selected work
      </h2>
      <a href="/work" style="font-family:var(--font-mono); font-size:12px; color:var(--color-accent);">see all &rarr;</a>
    </div>
    <div>
      {projects.slice(0, 3).map((project) => <ProjectRow project={project} />)}
    </div>
  </section>

  <section id="writing" style="max-width:var(--page-width); margin:0 auto; padding:0 24px 90px; scroll-margin-top:24px;">
    <div class="section-head">
      <h2 style="font-family:var(--font-display); font-size:26px; font-weight:600; margin:0; letter-spacing:-0.01em;">
        Writing
      </h2>
      <a href="/writing" style="font-family:var(--font-mono); font-size:12px; color:var(--color-accent);">see all &rarr;</a>
    </div>
    <div>
      {posts.slice(0, 3).map((post) => <PostRow post={post} />)}
    </div>
  </section>

  <section id="about" style="max-width:var(--page-width); margin:0 auto; padding:0 24px 90px; scroll-margin-top:24px;">
    <div
      style="display:grid; grid-template-columns:1.1fr 0.9fr; gap:60px; border-top:1px solid var(--color-border); padding-top:44px;"
    >
      <div>
        <h2 style="font-family:var(--font-display); font-size:26px; font-weight:600; margin:0 0 18px; letter-spacing:-0.01em;">
          About
        </h2>
        <div>
          {
            p.aboutParagraphs.map((t) => (
              <p style="font-size:16px; line-height:1.7; color:var(--color-text-soft); margin:0 0 16px;">{t}</p>
            ))
          }
        </div>
      </div>
      <div>
        <div
          style="font-family:var(--font-mono); font-size:12px; color:var(--color-text-softer); margin-bottom:14px; text-transform:uppercase; letter-spacing:0.05em;"
        >
          Toolbox
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          {p.skills.map((s) => <span class="chip-outline">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <footer id="contact" class="site-footer" style="scroll-margin-top:24px;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap;">
      <div>
        <h2 style="font-family:var(--font-display); font-size:26px; font-weight:600; margin:0 0 10px; letter-spacing:-0.01em;">
          {p.contactHeadline}
        </h2>
        <p style="font-size:15px; color:var(--color-text-soft); margin:0;">{p.contactSub}</p>
      </div>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <a href={`mailto:${p.socials.email}`} class="btn btn-dark">Email</a>
        <a href={p.socials.github} target="_blank" rel="noopener" class="btn btn-ghost">GitHub</a>
        <a href={p.socials.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn</a>
      </div>
    </div>
    <div style="margin-top:50px; font-family:var(--font-mono); font-size:11.5px; color:var(--color-text-softest);">
      &copy; 2026 Kenneth Imade &mdash; built with more care than the average Friday deploy.
    </div>
  </footer>
</BaseLayout>
