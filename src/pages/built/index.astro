---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).map((p) => ({ ...p, kind: 'product' as const }));
const projects = (await getCollection('projects')).map((p) => ({ ...p, kind: 'project' as const }));

const all = [...products, ...projects]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout
  title="Built — Kenneth Imade"
  description="Things I've built — products, APIs, and exploratory projects."
>

  <div class="mb-12">
    <h1 class="font-semibold mb-2">Built</h1>
    <p style="color: #666;">{products.length} {products.length === 1 ? 'product' : 'products'}, {projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
  </div>

  <ul class="flex flex-col">
    {all.map((item) => {
      const href = item.kind === 'product' ? (item.data.url ?? '#') : (item.data.githubUrl ?? '#');
      const external = !!href && href !== '#';
      return (
        <li class="border-t" style="border-color: #1e1e1e;">
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="flex justify-between gap-8 py-4 group"
          >
            <div class="min-w-0">
              <div class="flex items-center gap-3 mb-1">
                <span class="group-hover:text-sky-400 transition-colors duration-150 leading-snug">
                  {item.data.title}
                </span>
                <span class="text-sm px-1.5 py-0.5 rounded shrink-0" style={`border: 1px solid #2a2a2a; color: ${item.kind === 'product' ? '#38bdf8' : '#666'};`}>
                  {item.kind}
                </span>
              </div>
              <p class="text-sm leading-snug" style="color: #555;">{item.data.description}</p>
            </div>
            <div class="flex flex-col items-end gap-1.5 shrink-0">
              <time class="text-sm" style="color: #444;">{new Date(item.data.date).getFullYear()}</time>
              {(item.data.tags ?? []).length > 0 && (
                <span class="text-sm hidden md:block" style="color: #38bdf8;">
                  {(item.data.tags ?? []).slice(0, 2).join(', ')}
                </span>
              )}
            </div>
          </a>
        </li>
      );
    })}
  </ul>

</BaseLayout>
