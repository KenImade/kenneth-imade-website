---
// Case-study pages. Replaces project.html?slug=... — Astro pre-builds one
// static page per project that has a `caseStudy`. Slugs without one simply
// don't get a page (they 404), which replaces the old "not found" branch.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects
    .filter((p) => p.caseStudy)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const cs = project.caseStudy;
---

<BaseLayout title={`${project.title} — Kenneth Imade`}>
  <Nav back={{ href: "/work", label: "back to work" }} maxWidth="760px" />

  <header class="rise" style="max-width:760px; margin:0 auto; padding:60px 24px 40px;">
    <div
      style="font-family:var(--font-mono); font-size:12px; color:var(--color-accent); margin-bottom:16px; text-transform:uppercase; letter-spacing:0.05em;"
    >
      Case study &middot; {project.year}
    </div>
    <h1
      style="font-family:var(--font-display); font-weight:600; font-size:44px; line-height:1.12; letter-spacing:-0.02em; margin:0 0 22px;"
    >
      {cs.headline || project.title}
    </h1>
    <p style="font-size:18px; line-height:1.6; color:var(--color-text-soft); margin:0 0 30px; max-width:620px;">
      {cs.subhead || project.blurb}
    </p>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      {project.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    {
      (project.liveUrl || project.repoUrl) && (
        <div style="display:flex; gap:16px; align-items:center; margin-top:20px;">
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noopener" class="link" style="font-size:14px;">
              View live &#8599;
            </a>
          )}
          {project.repoUrl && (
            <a href={project.repoUrl} target="_blank" rel="noopener" class="link" style="font-size:14px;">
              View on GitHub &#8599;
            </a>
          )}
        </div>
      )
    }
  </header>

  <div
    style={`max-width:760px; margin:0 auto; padding:30px 24px; border-top:1px solid var(--color-border); border-bottom:1px solid var(--color-border); display:grid; grid-template-columns:repeat(${cs.stats.length},1fr); gap:24px;`}
  >
    {
      cs.stats.map((s) => (
        <div>
          <div style="font-family:var(--font-display); font-size:26px; font-weight:600; letter-spacing:-0.01em;">
            {s.value}
          </div>
          <div style="font-size:13px; color:var(--color-text-softer); margin-top:4px;">{s.label}</div>
        </div>
      ))
    }
  </div>

  <article style="max-width:var(--article-width); margin:0 auto; padding:50px 24px 30px;">
    {
      cs.sections.map((sec) => (
        <section style="margin-bottom:44px;">
          <h2 style="font-family:var(--font-display); font-size:22px; font-weight:600; margin:0 0 16px; letter-spacing:-0.01em;">
            {sec.heading}
          </h2>
          {sec.paragraphs.map((para) => (
            <p style="font-size:16px; line-height:1.75; color:var(--color-text-soft); margin:0 0 16px;">{para}</p>
          ))}
        </section>
      ))
    }
  </article>

  <footer
    style="max-width:var(--article-width); margin:0 auto; padding:50px 24px 70px; border-top:1px solid var(--color-border); margin-top:20px;"
  >
    <a href="/work" class="btn btn-dark">&larr; Back to all work</a>
  </footer>
</BaseLayout>
