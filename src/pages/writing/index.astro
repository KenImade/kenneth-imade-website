---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const years = [...new Set(posts.map((p) => new Date(p.data.date).getFullYear()))];
---

<BaseLayout
  title="Writing — Kenneth Imade"
  description="Writing on backend systems, data engineering, APIs, and building things."
>

  <div class="mb-12">
    <h1 class="font-semibold mb-2">Writing</h1>
    <p style="color: #666;">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </div>

  <div class="flex flex-col gap-12">
    {years.map((year) => {
      const yearPosts = posts.filter((p) => new Date(p.data.date).getFullYear() === year);
      return (
        <div>
          <p class="text-sm font-medium mb-4" style="color: #38bdf8; text-transform: uppercase; letter-spacing: 0.08em;">{year}</p>
          <ul class="flex flex-col">
            {yearPosts.map((post) => (
              <li class="border-t" style="border-color: #1e1e1e;">
                <a
                  href={`/writing/${post.id.replace(/\.(md|mdx)$/, '')}`}
                  class="flex justify-between gap-8 py-4 group"
                >
                  <div class="min-w-0">
                    <p class="group-hover:text-sky-400 transition-colors duration-150 leading-snug mb-1">
                      {post.data.title}
                    </p>
                    {post.data.description && (
                      <p class="text-sm leading-snug" style="color: #555;">{post.data.description}</p>
                    )}
                  </div>
                  <time class="text-sm shrink-0 pt-0.5" style="color: #444;">
                    {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>

</BaseLayout>
