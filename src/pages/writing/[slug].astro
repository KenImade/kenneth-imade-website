---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  return posts.map((post, i) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post, prev: posts[i + 1] ?? null, next: posts[i - 1] ?? null },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags } = post.data;

const readingTime = Math.ceil(post.body.trim().split(/\s+/).length / 200);
const formatted = new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={`${title} — Kenneth Imade`} description={description}>

  <!-- Progress bar -->
  <div id="reading-progress" style="position:fixed;top:0;left:0;right:0;height:2px;background:#38bdf8;width:0;z-index:50;transition:width 0.1s linear;" aria-hidden="true"></div>

  <a href="/writing" class="text-sm hover:text-sky-400 transition-colors duration-150 mb-10 block" style="color: #555;">← Writing</a>

  <div class="mb-10">
    <h1 class="font-semibold leading-snug mb-4" style="font-size: 1.5rem; max-width: 580px;">{title}</h1>
    {description && (
      <p class="mb-5 leading-relaxed" style="max-width: 560px; color: #888;">{description}</p>
    )}
    <div class="flex items-center gap-3 flex-wrap text-sm" style="color: #555;">
      <time>{formatted}</time>
      <span style="color: #333;">·</span>
      <span style="color: #38bdf8;">{readingTime} min read</span>
      {tags.length > 0 && (
        <>
          <span style="color: #333;">·</span>
          {tags.map((tag) => (
            <span style="color: #555;">{tag}</span>
          ))}
        </>
      )}
    </div>
  </div>

  <hr style="border-color: #1e1e1e; margin-bottom: 2.5rem;" />

  <div class="prose">
    <Content />
  </div>

  {(prev || next) && (
    <div class="mt-16 pt-8 flex justify-between gap-8" style="border-top: 1px solid #1e1e1e;">
      <div class="flex-1">
        {prev && (
          <a href={`/writing/${prev.id.replace(/\.(md|mdx)$/, '')}`} class="group block">
            <p class="text-sm mb-1.5" style="color: #38bdf8;">← Older</p>
            <p class="group-hover:text-sky-400 transition-colors duration-150 leading-snug">{prev.data.title}</p>
          </a>
        )}
      </div>
      <div class="flex-1 text-right">
        {next && (
          <a href={`/writing/${next.id.replace(/\.(md|mdx)$/, '')}`} class="group block">
            <p class="text-sm mb-1.5" style="color: #38bdf8;">Newer →</p>
            <p class="group-hover:text-sky-400 transition-colors duration-150 leading-snug">{next.data.title}</p>
          </a>
        )}
      </div>
    </div>
  )}

  <!-- Table of contents -->
  {tocHeadings.length > 0 && (
    <nav id="toc" aria-label="Table of contents" style="position:fixed;top:4rem;right:2rem;width:160px;display:none;">
      <p style="font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#333;margin-bottom:0.75rem;">On this page</p>
      <ul style="display:flex;flex-direction:column;gap:0.35rem;">
        {tocHeadings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              style={`font-size:0.7rem;line-height:1.4;display:block;transition:color 0.15s;color:#444;${h.depth === 3 ? 'padding-left:0.65rem;' : ''}`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

</BaseLayout>

<script>
  function initProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;
    function update() {
      const scrollable = document.body.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
      bar.style.width = `${Math.min(pct, 100)}%`;
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  function initToc() {
    const toc = document.getElementById('toc');
    if (!toc) return;

    // Only show when there's enough horizontal space
    function toggleVisibility() {
      toc.style.display = window.innerWidth >= 1280 ? 'block' : 'none';
    }
    toggleVisibility();
    window.addEventListener('resize', toggleVisibility, { passive: true });

    const links = toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (!links.length) return;

    const slugs = Array.from(links).map((l) => l.dataset.tocLink!);
    const headingEls = slugs.map((s) => document.getElementById(s)).filter(Boolean) as HTMLElement[];

    function setActive(slug: string) {
      links.forEach((l) => {
        const active = l.dataset.tocLink === slug;
        l.style.color = active ? '#38bdf8' : '#444';
        l.style.fontWeight = active ? '500' : '400';
      });
    }

    function onScroll() {
      let active = slugs[0];
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top <= 96) {
          active = el.id;
        }
      }
      setActive(active);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initProgress();
  initToc();
  document.addEventListener('astro:after-swap', () => {
    initProgress();
    initToc();
  });
</script>
